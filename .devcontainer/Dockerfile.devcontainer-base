FROM mcr.microsoft.com/devcontainers/python:1-3.12-bookworm

# Work around upstream Yarn apt key rotation / stale source entries in some base-image variants.
# Devcontainer features (e.g. docker-in-docker) invoke apt-get update; if this source remains and
# its key is unavailable, feature installation fails before the container is created.
RUN rm -f /etc/apt/sources.list.d/yarn.list \
    /etc/apt/sources.list.d/yarn*.list \
    /usr/share/keyrings/yarnkey.gpg \
    /usr/share/keyrings/yarn.gpg || true