# dYdX Trading Bot - Environment Variables Example
# Copy this to .env and fill in your values
# This file is for reference; use config.yaml or these env vars for configuration

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Type: sqlite (development) or postgresql (production)
DB_TYPE=sqlite
# Database name (SQLite filename or PostgreSQL database name)
DB_NAME=dydx_backtest.db
# PostgreSQL credentials (ignored for SQLite)
DB_USER=postgres
DB_PASSWORD=
# Database host and port
DB_HOST=localhost
DB_PORT=5432
# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=30
# Enable SQL query logging
SQL_ECHO=false

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================
# Enable/disable Redis caching
REDIS_ENABLED=true
# Redis server connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis authentication (if required)
REDIS_PASSWORD=
# Redis connection settings
REDIS_SSL=false
REDIS_TIMEOUT=5
# Cache TTL in seconds (24 hours = 86400)
REDIS_CACHE_TTL=86400
# Connection pool size
REDIS_MAX_CONNECTIONS=10

# ============================================================================
# dYdX EXCHANGE CONFIGURATION
# ============================================================================
# dYdX testnet vs mainnet
DYDX_CHAIN_ADDRESS=
DYDX_SECRET_PHRASE=
IS_TESTNET=false

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=INFO
LOKI_ENABLED=true
LOKI_URL=https://grafana.cydevcloud.com/loki
LOKI_USERNAME=loki
LOKI_PASSWORD=loki
LOKI_TENANT_ID=

# ============================================================================
# TELEGRAM NOTIFICATIONS
# ============================================================================
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================================
# ENVIRONMENT
# ============================================================================
# development or production
ENVIRONMENT=development

# ============================================================================
# NOTES
# ============================================================================
# 1. For SQLite: DB_PASSWORD, DB_USER, DB_HOST, DB_PORT are ignored
# 2. For Redis: Leave REDIS_PASSWORD empty if no auth is required
# 3. Sensitive values should be sourced from secure vaults in production
# 4. config.yaml takes precedence over environment variables
# 5. Some values require restarting the application to take effect
