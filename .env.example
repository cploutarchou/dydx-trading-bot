# Shared monorepo environment template
# Copy to .env for local development and stack/docker workflows:
#   cp .env.example .env

# Infra ports
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8888
PROXY_HTTP_PORT=8080

# Database credentials
POSTGRES_USER=dydx_bot
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=dydx_bot

# Shared DB aliases used by backend/bot local runtimes
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dydx_bot
DB_USER=dydx_bot
DB_PASSWORD=change-me-db-password
DB_TIMEOUT=5
DB_MAX_CONNECTIONS=10
DB_MAX_OVERFLOW=10
DB_ENABLED=true
DB_POOL_SIZE=5
SSL_MODE=false

# API/auth secrets
# NOTE: For production checks (`make stack-env-check-prod` / `make stack-up-prod`),
# SECRET_KEY must be non-placeholder and at least 32 chars.
SECRET_KEY=change-me-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
API_BYPASS_AUTH=false
FRONTEND_URL=http://localhost:5173

# Service-token model (backend -> bot delegated calls)
# Set BOT_API_USE_SERVICE_TOKEN=true to avoid forwarding end-user JWTs upstream.
BOT_API_TOKEN=
BOT_API_USE_SERVICE_TOKEN=true
# Optional overlap token on bot side during rotation windows.
BOT_API_TOKEN_PREVIOUS=
BOT_API_URL=http://localhost:8889
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8889
BOT_API_RELOAD=true

# Runtime environment
ENVIRONMENT=development
IS_TESTNET=true
BOT_API_WORKERS=1
BOT_INSTANCE_ID=bot-1
BOT_INSTANCE_NAME=Primary Trading Bot
BOT_MAX_INSTANCES=5
BOT_STATE_DIR=./bot/bot_states
BOT_AGENTS_FILE=bot_agents_{instance_id}.json
BOT_PAIRS_FILE=cointegrated_pairs_{instance_id}.json

# Optional bot strategy overrides
BOT_ABORT_ALL_POSITIONS=false
BOT_FIND_COINTEGRATED_PAIRS=false
BOT_MANAGE_EXITS=false
BOT_PLACE_TRADES=false
BOT_RESOLUTION_TIMEFRAME=1HOUR
BOT_STRATEGY=cointegration
BOT_STATS_WINDOW=21
BOT_MAX_HALF_LIFE=24
BOT_ZSCORE_THRESHOLD=1.5
BOT_USD_PER_TRADE=10.0
BOT_USD_MIN_COLLATERAL=100.0
BOT_CLOSE_AT_ZSCORE_CROSS=true

# Optional backtest tuning
BACKTEST_CANDLE_RESOLUTION=1HOUR
BACKTEST_MAX_HISTORY_DAYS=90
BACKTEST_STARTING_BALANCE=1000.0
BACKTEST_TRANSACTION_FEE=0.0005
BACKTEST_SLIPPAGE=0.001
BACKTEST_BENCHMARK_SYMBOL=BTC-USD
BACKTEST_RISK_FREE_RATE=0.02

# Optional notification/email settings
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net/v3
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=bot@example.com
FROM_NAME=dYdX Trading Bot

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CREDENTIALS_ENCRYPTION_KEY=change-me-fernet-key

# dYdX credentials (set for live trading; leave blank for non-trading/backtest mode)
# NOTE: If IS_TESTNET=false, strict production validation requires both
# DYDX_MAINNET_ADDRESS and DYDX_MAINNET_MNEMONIC to be non-placeholder values.
DYDX_TESTNET_ADDRESS=
DYDX_TESTNET_MNEMONIC=
DYDX_MAINNET_ADDRESS=
DYDX_MAINNET_MNEMONIC=

# Logging / Loki (optional)
LOG_LEVEL=INFO
LOKI_ENABLED=false
LOKI_URL=
LOKI_PUSH_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=
LOKI_LABELS={"job":"dydx-trading-bot","instance":"bot-1"}

# Redis runtime settings
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=5
REDIS_CACHE_TTL=86400
REDIS_CACHE_TTL_SECONDS=86400
REDIS_MAX_CONNECTIONS=10

# Frontend runtime API URL for production preview/build contexts
VITE_API_URL=http://localhost:8888