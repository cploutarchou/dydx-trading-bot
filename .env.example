# Root development environment placeholder.
# Do not commit real credentials. Prefer encrypted config profiles where available.

# Local infrastructure stack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dydx_bot
POSTGRES_USER=dydx_bot
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgres://dydx_bot:change-me-db-password@localhost:5432/dydx_bot?sslmode=disable

# Backend database aliases
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=dydx_bot
DB_PASSWORD=change-me-db-password
DB_NAME=dydx_bot
DB_AUTO_MIGRATE=false
# Proxies allowed to set X-Forwarded-For (comma-separated IPs/CIDRs). Loopback is
# always trusted. Behind an ingress controller set this to the cluster pod CIDR
# (k3s default: 10.42.0.0/16); otherwise every client shares the proxy's IP for
# rate limiting and audit logs. An invalid entry falls back to loopback only.
TRUSTED_PROXIES=

# Dedicated bot database (same local PostgreSQL server, separate ownership)
BOT_POSTGRES_DB=dydx_bot_runtime
BOT_DB_CUTOVER_MODE=dedicated
BOT_DATABASE_URL=postgresql+psycopg2://dydx_bot:change-me-db-password@localhost:5432/dydx_bot_runtime?sslmode=disable
BOT_DB_TYPE=postgres
BOT_DB_HOST=localhost
BOT_DB_PORT=5432
BOT_DB_NAME=dydx_bot_runtime
BOT_DB_USER=dydx_bot
BOT_DB_PASSWORD=change-me-db-password

# Cache / queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Messaging / analytics / object storage
# NATS events are enabled for local integration. Celery remains the authoritative
# executor, so command mirroring stays off until an explicit execution cutover.
NATS_ENABLED=true
BOT_COMMAND_BUS_ENABLED=false
NATS_URL=nats://localhost:4222
NATS_MONITORING_URL=http://localhost:8222
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dydx_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_ENABLED=true
CLICKHOUSE_SECURE=false
MINIO_ENDPOINT=localhost:9010
MINIO_CONSOLE_URL=http://localhost:9011
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=backtests
MINIO_ENABLED=true
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Backend auth
JWT_SECRET_KEY=replace-with-local-secret
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Bot Celery workers
BACKTEST_WORKER_BACKEND=celery
# Keep the API producer and worker on the same broker/result databases.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_QUEUES=backtests,default,high_priority,scheduled
# Celery worker autoscaling (max concurrent processes, min processes)
CELERY_AUTOSCALE=10,2
# Max tasks per worker child before respawn (prevents memory leaks)
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
# Prefetch multiplier (1 is optimal for autoscaling - prevents task hoarding)
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Broker visibility timeout (must exceed task_time_limit to prevent re-delivery)
CELERY_BROKER_VISIBILITY_TIMEOUT=665280
BACKTEST_CELERY_QUEUE=backtests
BACKTEST_CELERY_MAX_RETRIES=3
BACKTEST_CELERY_RETRY_BASE_SECONDS=30
BACKTEST_CELERY_RETRY_MAX_SECONDS=600
MARKET_SYNC_ENABLED=false
BACKTEST_ARTIFACT_STORAGE_ENABLED=true
BACKTEST_CLICKHOUSE_WRITES_ENABLED=true
BACKTEST_MINIO_ARTIFACTS_ENABLED=true
BACKTEST_CLICKHOUSE_ENABLED=true
BACKTEST_MINIO_ENABLED=true

# Backtest artifact storage strict/fail-closed mode
# When enabled, MinIO failures will cause visible errors instead of silently falling back to local storage
# Recommended for production: BACKTEST_ARTIFACT_STORAGE_STRICT=true
BACKTEST_ARTIFACT_STORAGE_STRICT=false
BACKTEST_MINIO_STRICT=false
MINIO_STRICT_MODE=false

# ICO / outbound email
PUBLIC_APP_URL=http://localhost:5173
ICO_EMAIL_OUTBOX_WORKER_ENABLED=true

# Outbound email goes through a Plunk project (POST {api url}/v1/send). The API
# URL, sender, reply-to and the project secret key (sk_...) are all managed in
# the admin panel (Settings -> Email) and stored in the database; the key is
# encrypted with ENCRYPTION_KEY. PLUNK_API_URL is only a fallback for the API
# base URL when none is saved. Never put the secret key in an environment file.
PLUNK_API_URL=

# Delivery-event webhook for ICO emails. It still verifies Mailgun-style
# signatures and rejects every request while this is empty.
MAILGUN_WEBHOOK_SIGNING_KEY=
