# Root development environment placeholder.
# Do not commit real credentials. Prefer encrypted config profiles where available.

# Local infrastructure stack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dydx_bot
POSTGRES_USER=dydx_bot
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgres://dydx_bot:change-me-db-password@localhost:5432/dydx_bot?sslmode=disable

# Backend / bot database compatibility aliases
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=dydx_bot
DB_PASSWORD=change-me-db-password
DB_NAME=dydx_bot
DB_AUTO_MIGRATE=false

# Cache / queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Messaging / analytics / object storage
# NATS is enabled by default: the backend dual-writes command intent to JetStream
# (Celery remains the authoritative backtest worker). Set to "false" to disable.
NATS_ENABLED=true
BOT_COMMAND_BUS_ENABLED=true
NATS_URL=nats://localhost:4222
NATS_MONITORING_URL=http://localhost:8222
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dydx_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_ENABLED=true
CLICKHOUSE_SECURE=false
MINIO_ENDPOINT=localhost:9010
MINIO_CONSOLE_URL=http://localhost:9011
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=backtests
MINIO_ENABLED=true
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Backend auth
JWT_SECRET_KEY=replace-with-local-secret
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Bot Celery workers
BACKTEST_WORKER_BACKEND=celery
CELERY_QUEUES=backtests,default,high_priority,scheduled
BACKTEST_CELERY_QUEUE=backtests
BACKTEST_CELERY_MAX_RETRIES=3
BACKTEST_CELERY_RETRY_BASE_SECONDS=30
BACKTEST_CELERY_RETRY_MAX_SECONDS=600
MARKET_SYNC_ENABLED=false
BACKTEST_ARTIFACT_STORAGE_ENABLED=true
BACKTEST_CLICKHOUSE_WRITES_ENABLED=true
BACKTEST_MINIO_ARTIFACTS_ENABLED=true
BACKTEST_CLICKHOUSE_ENABLED=true
BACKTEST_MINIO_ENABLED=true

# Backtest artifact storage strict/fail-closed mode
# When enabled, MinIO failures will cause visible errors instead of silently falling back to local storage
# Recommended for production: BACKTEST_ARTIFACT_STORAGE_STRICT=true
BACKTEST_ARTIFACT_STORAGE_STRICT=false
BACKTEST_MINIO_STRICT=false
MINIO_STRICT_MODE=false

# ICO / Mailgun operational placeholders
PUBLIC_APP_URL=http://localhost:5173
ICO_EMAIL_OUTBOX_WORKER_ENABLED=true
MAILGUN_REGION=us
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=noreply@executionlab.io
MAILGUN_FROM_NAME=ExecutionLab
MAILGUN_REPLY_TO_EMAIL=noreply@executionlab.io
MAILGUN_WEBHOOK_SIGNING_KEY=21212212

# Mailgun API keys must be configured through the backend secret/credential flow,
# not exposed in frontend environment variables.
