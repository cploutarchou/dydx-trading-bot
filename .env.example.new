# ============================================================================
# dYdX Trading Bot - Environment Variables Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# For secure deployment, use a secrets manager instead of .env files
# ============================================================================

# ============================================================================
# BOT SETTINGS - Core Trading Configuration
# ============================================================================

# Z-score threshold for entry signals (default: 1.5)
# Lower = more sensitive, Higher = fewer trades
BOT_ZSCORE_THRESHOLD=1.2

# Abort all open positions on startup (default: false)
BOT_ABORT_ALL_POSITIONS=false

# Close positions when Z-score crosses zero (mean reversion)
BOT_CLOSE_AT_ZSCORE_CROSS=true

# Find and analyze cointegrated pairs
BOT_FIND_COINTEGRATED_PAIRS=true

# Manage existing positions (monitor and close)
BOT_MANAGE_EXITS=true

# Execute new trades based on signals
BOT_PLACE_TRADES=true

# Resolution for price data (1MIN, 5MINS, 15MINS, 1HOUR, 4HOURS, 1DAY)
BOT_RESOLUTION_TIMEFRAME=1HOUR

# Statistical window for Z-score calculation (default: 21)
BOT_STATS_WINDOW=14

# Trading strategy (cointegration, pairs, etc.)
BOT_STRATEGY=cointegration

# Maximum half-life for cointegrated pairs in hours (default: 24)
BOT_MAX_HALF_LIFE=48

# Minimum USDC collateral required (default: 100)
BOT_USDC_MIN_COLLATERAL=50

# USD per trade (position size) (default: 10)
BOT_USD_PER_TRADE=25

# Indexer endpoints
INDEXER_TESTNET=https://indexer.v4testnet.dydx.exchange
INDEXER_MAINNET=https://indexer.dydx.trade

# ============================================================================
# BACKTESTING SETTINGS - Historical Simulation Configuration
# ============================================================================

# Candle resolution for backtesting (1MIN, 5MINS, 15MINS, 1HOUR, 4HOURS, 1DAY)
BACKTEST_CANDLE_RESOLUTION=1HOUR

# Maximum history days to fetch for backtesting (default: 90)
BACKTEST_MAX_HISTORY_DAYS=90

# Starting balance for backtest simulation in USD (default: 1000)
BACKTEST_STARTING_BALANCE=1000.0

# Transaction fee per trade (0.05% = 0.0005) (default: 0.0005)
BACKTEST_TRANSACTION_FEE=0.0005

# Estimated slippage per trade (0.1% = 0.001) (default: 0.001)
BACKTEST_SLIPPAGE=0.001

# Benchmark symbol for Sharpe ratio calculation
BACKTEST_BENCHMARK_SYMBOL=BTC-USD

# Risk-free rate for Sharpe ratio (annual %, 2% = 0.02)
BACKTEST_RISK_FREE_RATE=0.02

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database type: sqlite (development) or postgresql (production)
DB_TYPE=sqlite

# Database name or file path
# For SQLite: filename (e.g., dydx_backtest.db)
# For PostgreSQL: database name
DB_NAME=dydx_backtest.db

# PostgreSQL username (ignored for SQLite)
DB_USER=postgres

# PostgreSQL password (ignored for SQLite)
DB_PASSWORD=

# Database host (ignored for SQLite)
DB_HOST=localhost

# Database port (ignored for SQLite)
DB_PORT=5432

# Connection pool size (default: 5)
DB_POOL_SIZE=5

# Max overflow connections (default: 10)
DB_MAX_OVERFLOW=10

# Query timeout in seconds (default: 30)
DB_TIMEOUT=30

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================

# Enable/disable Redis caching (true/false)
REDIS_ENABLED=true

# Redis server hostname
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# Redis database number (0-15)
REDIS_DB=0

# Redis password (if required)
REDIS_PASSWORD=

# Use SSL/TLS connection (true/false)
REDIS_SSL=false

# Redis connection timeout in seconds
REDIS_TIMEOUT=5

# Cache TTL in seconds (86400 = 24 hours)
REDIS_CACHE_TTL=86400

# Maximum connections in pool
REDIS_MAX_CONNECTIONS=10

# ============================================================================
# dYdX EXCHANGE CONFIGURATION
# ============================================================================

# Use testnet (true) or mainnet (false)
IS_TESTNET=true

# Testnet dYdX chain address (your account address on testnet)
DYDX_TESTNET_CHAIN_ADDRESS=dydx1xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Testnet dYdX secret phrase / mnemonic
DYDX_TESTNET_SECRET_PHRASE=your testnet mnemonic seed phrase here

# Mainnet dYdX chain address (your account address on mainnet)
DYDX_MAINNET_CHAIN_ADDRESS=dydx1xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mainnet dYdX secret phrase / mnemonic
DYDX_MAINNET_SECRET_PHRASE=your mainnet mnemonic seed phrase here

# Encryption key for storing secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
DYDX_ENCRYPTION_KEY=

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development or production
ENVIRONMENT=development

# Loki logging (optional remote log aggregation)
LOKI_ENABLED=false
LOKI_URL=https://grafana.example.com/loki
LOKI_USERNAME=loki
LOKI_PASSWORD=
LOKI_TENANT_ID=
LOKI_JOB_NAME=dydx-trading-bot

# ============================================================================
# TELEGRAM NOTIFICATIONS
# ============================================================================

# Telegram bot token (get from @BotFather on Telegram)
TELEGRAM_TOKEN=

# Telegram chat ID (get by sending /start to @userinfobot)
TELEGRAM_CHAT_ID=

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit .env files to version control
# 2. For production, use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# 3. Generate DYDX_ENCRYPTION_KEY with:
#    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 4. For PostgreSQL, create the database first:
#    createdb dydx_trading_bot
# 5. Run migrations with:
#    alembic upgrade head
# 6. Test your configuration with:
#    python scripts/validate_config.py
# 7. For testnet funding, use:
#    python scripts/request_testnet_usdc.py
