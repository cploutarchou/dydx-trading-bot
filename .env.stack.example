# Copy to .env.stack and replace placeholders as needed:
#   cp .env.stack.example .env.stack

# Infra ports
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8889
PROXY_HTTP_PORT=8080

# Database credentials
POSTGRES_USER=dydx_bot
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=dydx_bot

# API/auth secrets
# NOTE: For production checks (`make stack-env-check-prod` / `make stack-up-prod`),
# SECRET_KEY must be non-placeholder and at least 32 chars.
SECRET_KEY=change-me-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
API_BYPASS_AUTH=false

# Runtime environment
ENVIRONMENT=development
IS_TESTNET=true
BOT_API_WORKERS=1

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# dYdX credentials (set for live trading; leave blank for non-trading/backtest mode)
# NOTE: If IS_TESTNET=false, strict production validation requires both
# DYDX_MAINNET_ADDRESS and DYDX_MAINNET_MNEMONIC to be non-placeholder values.
DYDX_TESTNET_ADDRESS=
DYDX_TESTNET_MNEMONIC=
DYDX_MAINNET_ADDRESS=
DYDX_MAINNET_MNEMONIC=

# Logging / Loki (optional)
LOG_LEVEL=INFO
LOKI_ENABLED=false
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=

# Frontend runtime API URL for production preview/build contexts
VITE_API_URL=http://localhost:8889
