# StackForge production deploy environment template for dydx-trading-bot
# Copy to `.env.stackforge` and replace placeholders before a live deploy.
# Usage example:
# stackforge --config stackforge.yaml --cluster stackforge-production --confirm-production deploy \
#   --file stackforge.yaml --mode nomad --nomad-address https://10.0.0.11:4646 \
#   --nomad-datacenter dc1 --env-file .env.stackforge

# Build metadata is injected automatically by `make deploy` / scripts/redeploy_with_immutable_tag.sh.

ENVIRONMENT=production
APP_CONFIG_ENV=production
APP_ENV=production
LOG_LEVEL=INFO

# Required app secrets (replace before live deploy)
SECRET_KEY=REPLACE_ME_SECRET_KEY
JWT_SECRET_KEY=REPLACE_ME_JWT_SECRET_KEY
ENCRYPTION_KEY=REPLACE_ME_ENCRYPTION_KEY

# Database credentials
APP_DB_NAME=app
APP_DB_USER=app
APP_DB_PASSWORD=REPLACE_ME_APP_DB_PASSWORD
APP_DB_ROOT_PASSWORD=REPLACE_ME_APP_DB_ROOT_PASSWORD

# Dedicated bot database credentials
BOT_DB_NAME=bot
BOT_DB_USER=bot
BOT_DB_PASSWORD=REPLACE_ME_BOT_DB_PASSWORD
BOT_DB_ROOT_PASSWORD=REPLACE_ME_BOT_DB_ROOT_PASSWORD

# Auth cookie settings
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Domains used by auto DNS and frontend build
APP_DOMAIN=executionlab.io
API_DOMAIN=api.executionlab.io

# Optional GitHub token for API calls/build tooling
GITHUB_API_TOKEN=REPLACE_ME_GITHUB_API_TOKEN

# Optional private registry auth
GHCR_USERNAME=REPLACE_ME_GHCR_USERNAME
GHCR_TOKEN=REPLACE_ME_GHCR_TOKEN
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DOCKER_REGISTRY=
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=

# Cloudflare defaults (optional)
CLOUDFLARE_API_TOKEN=REPLACE_ME_CLOUDFLARE_API_TOKEN
CLOUDFLARE_DEFAULT_ZONE_ID=

# Frontend URL wiring
VITE_API_URL=https://${API_DOMAIN}
VITE_API_BASE_URL=https://${API_DOMAIN}
VITE_AUTH_BASE_URL=https://${API_DOMAIN}
VITE_CLIENT_HOST=${APP_DOMAIN}
VITE_CRM_HOST=${APP_DOMAIN}
VITE_IB_PORTAL_HOST=${APP_DOMAIN}
