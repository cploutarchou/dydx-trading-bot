# Production template for StackForge deploy
# Copy to .env.stackforge and set real values before live deployment.
# Do NOT commit real secrets.

ENVIRONMENT=production
APP_CONFIG_ENV=production
LOG_LEVEL=INFO

# Required app secrets (generate strong random values)
SECRET_KEY=__REQUIRED_SECRET_KEY_MIN_32_CHARS__
JWT_SECRET_KEY=__REQUIRED_JWT_SECRET_KEY_MIN_32_CHARS__
ENCRYPTION_KEY=__REQUIRED_ENCRYPTION_KEY_MIN_32_CHARS__

# Database credentials
APP_DB_NAME=app
APP_DB_USER=app
APP_DB_PASSWORD=__REQUIRED_DB_PASSWORD__

# Real production domains
APP_DOMAIN=__REQUIRED_APP_DOMAIN__
API_DOMAIN=__REQUIRED_API_DOMAIN__

# Optional GitHub token for build tooling / API workflows
GITHUB_API_TOKEN=

# Optional private registry auth
GHCR_USERNAME=
GHCR_TOKEN=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DOCKER_REGISTRY=
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=

# Cloudflare defaults (required only if using auto DNS)
CLOUDFLARE_DEFAULT_ZONE_ID=
# CLOUDFLARE_API_TOKEN is read from environment at deploy time when needed.

# Frontend URL wiring
VITE_API_URL=https://${API_DOMAIN}
VITE_API_BASE_URL=https://${API_DOMAIN}
VITE_AUTH_BASE_URL=https://${API_DOMAIN}
VITE_CLIENT_HOST=${APP_DOMAIN}
