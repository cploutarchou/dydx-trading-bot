{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Backend API (FastAPI :8889)",
			"type": "node-terminal",
			"request": "launch",
			"command": "python3 -m uvicorn src.api.server:app --host 0.0.0.0 --port 8889 --reload",
			"cwd": "${workspaceFolder}/bot"
		},
		{
			"name": "Bot Worker (instance bot-1)",
			"type": "node-terminal",
			"request": "launch",
			"command": "python3 src/main_instance.py --instance-id bot-1",
			"cwd": "${workspaceFolder}/bot"
		},
		{
			"name": "Frontend (Vite :5173)",
			"type": "node-terminal",
			"request": "launch",
			"command": "npm run dev",
			"cwd": "${workspaceFolder}/frontend"
		}
	]
}