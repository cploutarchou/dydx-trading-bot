{
  // ========== GO DEVELOPMENT (Go 1.25.0 + Gin + golangci-lint) ==========
  "go.useLanguageServer": true,
  "go.lintOnSave": "package",
  "go.lintTool": "golangci-lint",
  "go.lintFlags": [
    "--config=${workspaceFolder}/backend/.golangci.yml",
    "--timeout=5m"
  ],
  "go.formatOnSave": true,
  "go.formatTool": "goimports",
  "go.useGoProxyToCheckGoVersion": false,
  "go.liveErrors": {
    "enabled": true,
    "delay": 500
  },
  "go.coverOnSingleTest": true,
  "go.coverOnSingleTestFile": true,
  "go.testTimeout": "30s",
  "go.testEnvVars": {},
  "go.testFlags": ["-v", "-race"],
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "golang.go"
  },
  "[go.mod]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go"
  },
  "gopls": {
    "ui.completion.usePlaceholders": true,
    "ui.diagnostic.annotations": {
      "bounds": true,
      "escape": true,
      "inline": true,
      "nil": true
    }
  },

  // ========== PYTHON DEVELOPMENT (FastAPI bot) ==========
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "python.formatting.provider": "black",
  "python.formatting.blackArgs": ["--line-length=100"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "-v"],

  // ========== TYPESCRIPT/JAVASCRIPT (React Frontend) ==========
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "prettier.semi": true,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5",
  "prettier.tabWidth": 2,
  "eslint.validate": [
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact"
  ],

  // ========== MARKDOWN & DOCUMENTATION ==========
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "markdown.preview.breaks": true,
  "markdown.preview.linkify": true,
  "markdown.preview.fontSize": 14,

  // ========== FILE EXCLUSIONS & WORKSPACE ==========
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/.pytest_cache": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/bin": true,
    "**/.venv": true,
    "**/.env": true,
    "**/.DS_Store": true,
    "**/vendor": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/vendor/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/vendor": true,
    "**/.venv": true,
    "**/bin": true,
    "go.sum": true,
    "package-lock.json": true
  },

  // ========== EDITOR SETTINGS ==========
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.rulers": [80, 120],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ========== TESTING ==========
  "testing.automaticallyOpenPeekView": "failureInVisibleDocument",

  // ========== DOCKER ==========
  "docker.defaultRegistry": "ghcr.io",
  "docker.commands.build.useDefaultContext": true,

  // ========== GIT ==========
  "git.ignoreLimitWarning": true,
  "containers.commands.build": {
    "useDefaultContext": true
  }
}
