# ============================================================================
# DYDX TRADING BOT - Backend Configuration (.env file)
# ============================================================================
# This file contains all environment variables required for the Go backend.
# Copy this to .env and fill in your actual values.

# ============================================================================
# API Server Configuration
# ============================================================================
API_PORT=8080

# ============================================================================
# Database Configuration
# ============================================================================
# Choose database type: postgresql, postgres, sqlite, sqlite3
DB_TYPE=sqlite3

# For SQLite:
DB_NAME=trading_bot

# For PostgreSQL:
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dydx_trading_bot
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# SSL_MODE=disable

# Connection pool settings (critical for performance)
# MAX_OPEN_CONNS: Maximum number of open connections to database
DB_MAX_CONNECTIONS=25
# MAX_IDLE_CONNS: Maximum idle connections to keep in pool
DB_MAX_IDLE_CONNECTIONS=5
# CONN_MAX_LIFETIME: Maximum lifetime of a connection (prevents stale connections)
DB_CONN_MAX_LIFETIME=5m
# CONN_MAX_IDLE_TIME: Maximum idle time before connection is closed
DB_CONN_MAX_IDLE_TIME=2m

DB_TIMEOUT=5
DB_MAX_OVERFLOW=10
DB_POOL_SIZE=5
DB_ENABLED=true

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# RATE_LIMIT_RPS: Requests per second per client IP
RATE_LIMIT_RPS=100
# RATE_LIMIT_BURST: Maximum burst size (concurrent requests)
RATE_LIMIT_BURST=200

# ============================================================================
# Redis Configuration (for caching and session management)
# ============================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=5
REDIS_CACHE_TTL=86400
REDIS_MAX_CONNECTIONS=10

# ============================================================================
# JWT Authentication Configuration
# ============================================================================
# IMPORTANT: Change these in production!
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for storing sensitive data (dYdX secrets, etc.)
ENCRYPTION_KEY=your-encryption-key-32-chars-minimum

# ============================================================================
# dYdX Chain Configuration
# ============================================================================
IS_TESTNET=true

# Testnet credentials
DYDX_TESTNET_ADDRESS=dydx1...
DYDX_TESTNET_SECRET=your_testnet_mnemonic_phrase

# Mainnet credentials
DYDX_MAINNET_ADDRESS=dydx1...
DYDX_MAINNET_SECRET=your_mainnet_mnemonic_phrase

# ============================================================================
# Telegram Configuration (for alerts and notifications)
# ============================================================================
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ============================================================================
# Loki Logging Configuration (optional)
# ============================================================================
LOKI_ENABLED=false
LOKI_PUSH_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=
LOKI_LABELS=service=dydx-trading-bot,environment=development

