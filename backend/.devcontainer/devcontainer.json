{
	"name": "dYdX Trading Bot Backend (Go)",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"ms-vscode.makefile-tools",
				"ms-azuretools.vscode-docker",
				"redhat.vscode-yaml",
				"eamodio.gitlens",
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"ms-vscode-remote.remote-containers"
			],
			"settings": {
				"go.toolsManagement.autoUpdate": true,
				"go.toolsManagement.checkForUpdates": "local",
				"go.useLanguageServer": true,
				"go.lintTool": "golangci-lint",
				"go.lintOnSave": "package",
				"go.vetOnSave": "package",
				"go.testOnSave": false,
				"go.testTimeout": "30s",
				"go.coverOnTestPackage": true,
				"go.generateTestsFlags": [
					"-all"
				],
				"gopls": {
					"ui.semanticTokens": true,
					"ui.completion.usePlaceholders": true,
					"formatting.gofumpt": true,
					"analyses": {
						"unusedparams": true,
						"shadow": true,
						"unusedwrite": true
					},
					"staticcheck": true
				},
				"[go]": {
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.organizeImports": "explicit"
					},
					"editor.defaultFormatter": "golang.go",
					"editor.tabSize": 4,
					"editor.insertSpaces": false
				},
				"go.testFlags": [
					"-v",
					"-race"
				],
				"testing.automaticallyOpenPeekView": "never",
				"go.envFile": "${workspaceFolder}/.env",
				"[sql]": {
					"editor.formatOnSave": true
				},
				"files.exclude": {
					"**/.git": false,
					"**/bin": true,
					"**/.air.toml": false,
					"**/__debug_bin*": true
				},
				"files.watcherExclude": {
					"**/.git/objects/**": true,
					"**/bin/**": true
				},
				"search.exclude": {
					"**/bin": true,
					"**/vendor": true
				}
			}
		}
	},
	"forwardPorts": [
		8888,
		5433,
		6380
	],
	"portsAttributes": {
		"8888": {
			"label": "Go Backend API",
			"onAutoForward": "notify"
		},
		"5433": {
			"label": "Backend Postgres (host mapped)",
			"onAutoForward": "silent"
		},
		"6380": {
			"label": "Backend Redis (host mapped)",
			"onAutoForward": "silent"
		}
	},
	"postCreateCommand": "bash -lc 'go mod download && make install-tools'",
	"remoteUser": "vscode"
}