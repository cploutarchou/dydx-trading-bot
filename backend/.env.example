# ════════════════════════════════════════════════════════════════════════════
# dYdX Trading Bot - Backend Configuration Template
# ════════════════════════════════════════════════════════════════════════════

# SERVER CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
API_PORT=8888
APP_ENV=development

# Optional bot API delegation settings
BOT_API_URL=http://localhost:8000
BOT_API_TOKEN=

# DATABASE CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
# Supported: sqlite3, postgres
DB_TYPE=postgres

# SQLite configuration (used when DB_TYPE=sqlite3)
DB_NAME=trading_bot

# PostgreSQL Configuration (when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dydx_bot
DB_USER=dydx_bot
DB_PASSWORD=secure_password
SSL_MODE=false

# Database runtime settings
DB_TIMEOUT=5
DB_MAX_CONNECTIONS=10
DB_MAX_OVERFLOW=10
DB_ENABLED=true
DB_POOL_SIZE=5

# REDIS CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=5

# Redis Cache Settings
REDIS_CACHE_TTL=86400
REDIS_MAX_CONNECTIONS=10

# AUTHENTICATION & SECURITY
# ════════════════════════════════════════════════════════════════════════════
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Used by key encryption service (AES-256)
ENCRYPTION_KEY=your-encryption-key-change-in-production-min-32-chars

# dYdX CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
# NOTE: current code checks for exact string "True"
IS_TESTNET=False
DYDX_MAINNET_ADDRESS=dydx1...
DYDX_MAINNET_SECRET=your-mainnet-mnemonic-phrase
DYDX_TESTNET_ADDRESS=dydx1...
DYDX_TESTNET_SECRET=your-testnet-mnemonic-phrase

# Loki Configuration (Optional)
# NOTE: current code checks for exact string "True"
LOKI_ENABLED=False
LOKI_PUSH_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=
LOKI_LABELS=env=development,service=dydx-trading-bot

# TELEGRAM CONFIGURATION (Optional)
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ════════════════════════════════════════════════════════════════════════════
# USAGE:
#   1. Copy this file to .env in the backend root directory
#   2. Update values with your actual configuration
#   3. For production, use strong passwords and secure key management
#   4. Never commit .env file to version control
# ════════════════════════════════════════════════════════════════════════════

