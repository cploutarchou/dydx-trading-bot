 # ════════════════════════════════════════════════════════════════════════════
# dYdX Trading Bot - Backend Configuration Template
# ════════════════════════════════════════════════════════════════════════════

# SERVER CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
API_PORT=8888
API_HOST=0.0.0.0
ENV=development

# DATABASE CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
# Supported: sqlite3, postgres
DB_TYPE=sqlite3

# SQLite Configuration (when DB_TYPE=sqlite3)
DB_PATH=trading_bot.db

# PostgreSQL Configuration (when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=trading_bot_user
DB_PASSWORD=your-secure-password-here
DB_SSL_MODE=disable

# Database Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=0

# REDIS CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=5

# Redis Cache Settings
REDIS_CACHE_TTL_SECONDS=86400
REDIS_MAX_CONNECTIONS=10
REDIS_CACHE_BACKTEST_RESULTS=true
REDIS_CACHE_MARKET_DATA=true
REDIS_CACHE_ANALYSIS_RESULTS=true

# AUTHENTICATION & SECURITY
# ════════════════════════════════════════════════════════════════════════════
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# CORS CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# dYdX CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
DYDX_TESTNET=false
DYDX_MAINNET_ADDRESS=dydx1...
DYDX_MAINNET_SECRET=your-mainnet-mnemonic-phrase
DYDX_TESTNET_ADDRESS=dydx1...
DYDX_TESTNET_SECRET=your-testnet-mnemonic-phrase

# dYdX Indexer Configuration
DYDX_INDEXER_MAINNET=https://indexer.dydx.trade
DYDX_INDEXER_TESTNET=https://indexer.v4testnet.dydx.exchange

# LOGGING CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
LOG_LEVEL=info
LOG_FORMAT=json

# Loki Configuration (Optional)
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=
LOKI_ENVIRONMENT=development
LOKI_SERVICE=dydx-trading-bot

# TELEGRAM CONFIGURATION (Optional)
# ════════════════════════════════════════════════════════════════════════════
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ════════════════════════════════════════════════════════════════════════════
# USAGE:
#   1. Copy this file to .env in the backend-go root directory
#   2. Update values with your actual configuration
#   3. For production, use strong passwords and secure key management
#   4. Never commit .env file to version control
# ════════════════════════════════════════════════════════════════════════════

