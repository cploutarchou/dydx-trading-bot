# sample.env - environment variables for the dYdX trading bot

# Indexer endpoints
INDEXER_TESTNET_URL=https://indexer.v4testnet.dydx.exchange
INDEXER_MAINNET_URL=https://indexer.dydx.trade

# Database settings
DATABASE_TYPE=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DBNAME=dydx_bot
DATABASE_USER=dydx_bot
DATABASE_PASSWORD=
DATABASE_SSL=False
DATABASE_TIMEOUT=5
DATABASE_MAX_CONNECTIONS=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ENABLED=True
# Optional full DSN (overrides individual DB_* fields when present)
DATABASE_DSN=

# Wallet / Ethereum
WALLET_ETHEREUM_ADDRESS=
WALLET_ETHEREUM_PRIVATE_KEY=

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# dYdX settings
DYDX_IS_TESTNET=False
DYDX_TESTNET_CHAIN_ADDRESS=
DYDX_TESTNET_CHAIN_SECRET=
DYDX_MAINNET_CHAIN_ADDRESS=
DYDX_MAINNET_CHAIN_SECRET=

# Loki (logging)
LOKI_ENABLED=False
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=
# Comma-separated labels, e.g. env:prod,service:bot
LOKI_LABELS=

# Backtest
BACKTEST_CANDLE_RESOLUTION=1HOUR
BACKTEST_MAX_HISTORY_DAYS=90
BACKTEST_STARTING_BALANCE=1000.0
BACKTEST_TRANSACTION_FEE=0.0005
BACKTEST_SLIPPAGE=0.001
BACKTEST_BENCHMARK_SYMBOL=BTC-USD
BACKTEST_RISK_FREE_RATE=0.02

# Redis / cache
REDIS_ENABLED=True
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=False
REDIS_TIMEOUT=5
REDIS_MAX_CONNECTIONS=10
REDIS_TTL_SECONDS=86400
REDIS_CACHE_TTL_SECONDS=86400

# Auth / JWT
AUTH_JWT_SECRET_KEY=your-secret-key-change-in-production-use-strong-32-chars
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

