#!/usr/bin/env sh
# Extension-less entrypoint referenced by devcontainer.json initializeCommand.
# VS Code Dev Containers CLI executes this literal path via /bin/sh -c;
# JetBrains resolves ensure-network.sh / ensure-network.cmd per host OS.
# Bootstrap shared infra and the supervised Celery worker before compose starts.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
exec make -C "$REPO_ROOT" bot-runtime-up
