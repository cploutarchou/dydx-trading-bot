# dYdX Trading Bot Environment Configuration
# Copy this to .env and configure your values

# =============================================================================
# NETWORK CONFIGURATION (Static - rarely changes)
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# JWT AUTHENTICATION CONFIGURATION
# =============================================================================
SECRET_KEY=your-super-secret-key-here-change-this-in-production-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Security settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Email provider: 'mailgun' or 'smtp'
EMAIL_PROVIDER=mailgun

# Mailgun Configuration (Recommended for production)
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=yourdomain.com
MAILGUN_API_URL=https://api.mailgun.net/v3

# SMTP Configuration (Fallback or development)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true

# Email settings
FROM_EMAIL=bot@example.com
FROM_NAME=dYdX Trading Bot
FRONTEND_URL=http://localhost:8000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_TYPE=postgresql
DB_NAME=dydx_bot
DB_HOST=localhost
DB_PORT=5432
DB_USER=dydx_bot
DB_PASSWORD=secure_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO_SQL=false

# For PostgreSQL (production):
# DB_TYPE=postgresql
# DB_HOST=your-postgres-host
# DB_PORT=5432
# DB_USER=your_db_user
# DB_PASSWORD=your_secure_db_password
# DB_NAME=your_db_name

# =============================================================================
# TELEGRAM NOTIFICATIONS
# =============================================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# =============================================================================
# DYDX TRADING CONFIGURATION
# =============================================================================
# ⚠️  IMPORTANT: dYdX credentials are now managed via database!
#
# Previously, credentials were stored in .env files. This is now deprecated.
# All wallet credentials (address and mnemonic) should be managed through:
#
#   API Endpoint: POST /api/v1/dydx/credentials
#
# Credentials are:
#  - Encrypted at rest in the database using Fernet encryption
#  - Managed per-user with full audit trail
#  - Tested automatically for validity
#  - Can be created, updated, deleted without restarting the bot
#
# Migration steps:
# 1. Start the bot API server
# 2. Authenticate with your user credentials
# 3. Use POST /api/v1/dydx/credentials to add your wallet
# 4. Verify with POST /api/v1/dydx/credentials/{id}/test
# 5. Bot will automatically use active, tested credentials
#
# For complete API documentation, see: DYDX_CREDENTIALS_API.md

# Network selection: true for testnet, false for mainnet
# This only controls which network endpoints are used
# Actual credentials come from the database
IS_TESTNET=true

# Optional auth bypass for local development only (never enable in production)
API_BYPASS_AUTH=false

# Service-token auth for backend->bot delegated paths (optional model)
# If set, the bot accepts this token as an internal service credential.
BOT_API_TOKEN=
# Temporary overlap token for zero-downtime rotation windows.
BOT_API_TOKEN_PREVIOUS=
# Optional comma-separated token pool (advanced).
BOT_API_TOKENS=

# =============================================================================
# OPTIONAL BOT STRATEGY OVERRIDES (advanced)
# =============================================================================
BOT_ABORT_ALL_POSITIONS=false
BOT_FIND_COINTEGRATED_PAIRS=false
BOT_MANAGE_EXITS=false
BOT_PLACE_TRADES=false
BOT_RESOLUTION_TIMEFRAME=1HOUR
BOT_STRATEGY=cointegration
BOT_STATS_WINDOW=21
BOT_MAX_HALF_LIFE=24
BOT_ZSCORE_THRESHOLD=1.5
BOT_USD_PER_TRADE=10.0
BOT_USD_MIN_COLLATERAL=100.0
BOT_CLOSE_AT_ZSCORE_CROSS=true

# =============================================================================
# OPTIONAL BACKTEST TUNING (advanced)
# =============================================================================
BACKTEST_CANDLE_RESOLUTION=1HOUR
BACKTEST_MAX_HISTORY_DAYS=90
BACKTEST_STARTING_BALANCE=1000.0
BACKTEST_TRANSACTION_FEE=0.0005
BACKTEST_SLIPPAGE=0.001
BACKTEST_BENCHMARK_SYMBOL=BTC-USD
BACKTEST_RISK_FREE_RATE=0.02

# =============================================================================
# OPTIONAL TESTNET PREFLIGHT/SAFETY TUNING
# =============================================================================
DYDX_TESTNET_ADDRESS=
DYDX_TESTNET_MNEMONIC=
DYDX_MAINNET_ADDRESS=
DYDX_MAINNET_MNEMONIC=
INDEXER_ENDPOINT=
CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=3
MAX_DRAWDOWN_PCT=10

# Encryption key for credential storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP THIS SECURE - DO NOT COMMIT TO VERSION CONTROL!
CREDENTIALS_ENCRYPTION_KEY=your_fernet_key_here

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO

# Loki Integration (Optional)
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=
LOKI_LABELS={"job":"dydx-trading-bot","instance":"bot-1"}

# =============================================================================
# REDIS CACHE (Optional)
# =============================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=5
REDIS_CACHE_TTL_SECONDS=86400
REDIS_MAX_CONNECTIONS=10

# Backtesting configuration removed - now passed as API parameters

# =============================================================================
# BOT API SERVER (Multi-Instance Support)
# =============================================================================
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8889
BOT_API_WORKERS=1

# Bot Instance Configuration
BOT_INSTANCE_ID=bot-1
BOT_INSTANCE_NAME=Primary Trading Bot
BOT_MAX_INSTANCES=5

# State File Isolation
BOT_STATE_DIR=./bot_states
BOT_AGENTS_FILE=bot_agents_{instance_id}.json
BOT_PAIRS_FILE=cointegrated_pairs_{instance_id}.json

# =============================================================================
# MAILGUN SETUP INSTRUCTIONS
# =============================================================================
# 1. Create a Mailgun account at https://www.mailgun.com/
# 2. Verify your domain or use Mailgun's sandbox domain for testing
# 3. Get your API key from the Mailgun dashboard
# 4. Update the MAILGUN_API_KEY and MAILGUN_DOMAIN values above
# 5. For production, add your domain's MX, TXT, and CNAME records as instructed by Mailgun
#
# Mailgun Sandbox Domain (for testing):
# - You can use Mailgun's sandbox domain for testing without domain verification
# - Sandbox domain format: sandboxXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.mailgun.org
# - Only authorized recipients can receive emails in sandbox mode
#
# Domain Verification (for production):
# - Add the following DNS records to your domain:
#   * TXT record: v=spf1 include:mailgun.org ~all
#   * TXT record for DKIM (provided by Mailgun)
#   * CNAME record for tracking (optional)
#   * MX records if using Mailgun for incoming mail

# =============================================================================
# GMAIL SMTP SETUP (Alternative)
# =============================================================================
# If using Gmail SMTP instead of Mailgun:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Generate an App Password: https://support.google.com/accounts/answer/185833
# 3. Use your Gmail address for SMTP_USERNAME
# 4. Use the App Password (not your regular password) for SMTP_PASSWORD
# 5. Set EMAIL_PROVIDER=smtp

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# For development/testing, you can use MailCatcher or similar tools:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false