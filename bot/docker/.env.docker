# =============================================================================
# Docker Environment Configuration for dYdX Trading Bot
# =============================================================================
# Copy this to .env.docker and configure your production values
# This file is used by docker-compose.yml
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_NAME=dydx_trading_bot
DB_USER=botuser
DB_PASSWORD=change_this_strong_password_in_production

# =============================================================================
# JWT AUTHENTICATION - CRITICAL: CHANGE IN PRODUCTION
# =============================================================================
SECRET_KEY=generate-a-secure-secret-key-at-least-32-characters-long-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=yourdomain.com
FROM_EMAIL=noreply@yourdomain.com

# Alternative SMTP Configuration
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=change_redis_password_in_production

# =============================================================================
# DYDX TRADING CONFIGURATION
# =============================================================================
DYDX_NETWORK=testnet
# Change to 'mainnet' for production trading

# Your dYdX credentials (set these as Docker secrets in production)
# DYDX_MNEMONIC=your-wallet-mnemonic-phrase
# DYDX_PRIVATE_KEY=your-private-key

# =============================================================================
# MONITORING (Optional)
# =============================================================================
GRAFANA_PASSWORD=admin123_change_this

# =============================================================================
# DOMAIN AND SSL CONFIGURATION
# =============================================================================
DOMAIN=localhost
# Change to your actual domain: DOMAIN=yourdomain.com

# =============================================================================
# PRODUCTION SECURITY NOTES
# =============================================================================
# 1. Generate a strong SECRET_KEY:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. Use Docker secrets for sensitive data:
#    - Database passwords
#    - API keys
#    - Private keys
#
# 3. Enable HTTPS with valid SSL certificates
#
# 4. Use strong, unique passwords for all services
#
# 5. Regularly rotate credentials
#
# 6. Backup encryption keys securely