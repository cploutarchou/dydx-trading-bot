# dYdX Trading Bot Environment Configuration Example
# Copy to .env and update with your actual values
# NOTE: Trading parameters are sent via API, not stored here

# ============================================================================
# NETWORK CONFIGURATION (Static - rarely changes)
# ============================================================================
ENVIRONMENT=development

# ============================================================================
# TELEGRAM NOTIFICATIONS (Static)
# ============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================================
# LOGGING & MONITORING (Static)
# ============================================================================
LOG_LEVEL=INFO

# Loki Integration (Optional)
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=

# ============================================================================
# DATABASE CONFIGURATION (Static)
# ============================================================================
DB_TYPE=sqlite
DB_NAME=dydx_bot.db

# PostgreSQL Settings (if DB_TYPE=postgresql)
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=30

# ============================================================================
# REDIS CACHE (Static)
# ============================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=5
REDIS_CACHE_TTL_SECONDS=86400
REDIS_MAX_CONNECTIONS=10

# ============================================================================
# BOT API SERVER (Static)
# ============================================================================
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8889
BOT_API_WORKERS=1
BOT_MAX_INSTANCES=10

# State File Isolation
BOT_STATE_DIR=./bot_states