{
  "metadata": {
    "environment": "production",
    "description": "Production defaults for the dYdX trading monorepo"
  },
  "frontend": {
    "VITE_API_URL": "https://api.your-domain.example",
    "VITE_FORCE_MOCK_DATA": false
  },
  "shared": {
    "APP_ENV": "production",
    "ENVIRONMENT": "production",
    "IS_TESTNET": false,
    "API_PORT": 8888,
    "PROXY_HTTP_PORT": 8080,
    "FRONTEND_URL": "https://app.your-domain.example"
  },
  "security": {
    "JWT_ALGORITHM": "HS256",
    "ACCESS_TOKEN_EXPIRE_MINUTES": 30,
    "REFRESH_TOKEN_EXPIRE_DAYS": 7
  },
  "backend": {
    "BOT_API_URL": "https://bot-api.your-domain.example",
    "BOT_API_USE_SERVICE_TOKEN": true
  },
  "database": {
    "DB_TYPE": "postgres",
    "DB_HOST": "postgres",
    "DB_PORT": 5432,
    "DB_NAME": "dydx_bot",
    "DB_USER": "dydx_bot",
    "DB_TIMEOUT": 5,
    "DB_ENABLED": true,
    "DB_POOL_SIZE": 5,
    "DB_MAX_CONNECTIONS": 25,
    "DB_MAX_OVERFLOW": 10,
    "SSL_MODE": true,
    "DB_ECHO_SQL": false,
    "POSTGRES_HOST": "postgres",
    "POSTGRES_PORT": 5432,
    "POSTGRES_DB": "dydx_bot",
    "POSTGRES_USER": "dydx_bot"
  },
  "redis": {
    "REDIS_ENABLED": true,
    "REDIS_HOST": "redis",
    "REDIS_PORT": 6379,
    "REDIS_DB": 0,
    "REDIS_SSL": false,
    "REDIS_TIMEOUT": 5,
    "REDIS_CACHE_TTL": 86400,
    "REDIS_MAX_CONNECTIONS": 50
  },
  "bot_api": {
    "BOT_API_HOST": "0.0.0.0",
    "BOT_API_PORT": 8889,
    "BOT_API_RELOAD": false,
    "BOT_API_WORKERS": 2,
    "BOT_MANAGER_MONITOR_INTERVAL_SECONDS": 10,
    "BOT_STARTUP_GRACE_SECONDS": 0.5
  },
  "bot_runtime": {
    "BOT_PLACE_TRADES": true,
    "BOT_MANAGE_EXITS": true,
    "BOT_ABORT_ALL_POSITIONS": false,
    "BOT_FIND_COINTEGRATED_PAIRS": true,
    "BOT_RESOLUTION_TIMEFRAME": "1HOUR",
    "BOT_STRATEGY": "cointegration",
    "BOT_STATS_WINDOW": 21,
    "BOT_MAX_HALF_LIFE": 24,
    "BOT_ZSCORE_THRESHOLD": 1.5,
    "BOT_USD_PER_TRADE": 10.0,
    "BOT_USD_MIN_COLLATERAL": 100.0,
    "BOT_CLOSE_AT_ZSCORE_CROSS": true
  },
  "backtesting": {
    "BACKTEST_CANDLE_RESOLUTION": "1HOUR",
    "BACKTEST_MAX_HISTORY_DAYS": 365,
    "BACKTEST_STARTING_BALANCE": 10000.0,
    "BACKTEST_TRANSACTION_FEE": 0.0005,
    "BACKTEST_SLIPPAGE": 0.001,
    "BACKTEST_BENCHMARK_SYMBOL": "BTC-USD",
    "BACKTEST_RISK_FREE_RATE": 0.02
  },
  "observability": {
    "LOG_LEVEL": "INFO",
    "LOKI_ENABLED": true,
    "LOKI_LABELS": "{\"app\":\"dydx-trading-bot\",\"env\":\"production\"}"
  },
  "integrations": {
    "CODEX_IO_BASE_URL": "https://graph.codex.io/graphql",
    "COINDESK_RSS_URL": "https://www.coindesk.com/arc/outboundfeeds/rss/",
    "MAILGUN_API_BASE_URL": "",
    "MAILGUN_API_BASE_URL_EU": ""
  }
}
