# Copy this file to secrets.local-secret.yaml for local bootstrap.
# The copied file is ignored by Git via .gitignore.
# Replace every placeholder before applying to a cluster.

apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
type: Opaque
stringData:
  username: REPLACE_ME
  password: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: backend-database
type: Opaque
stringData:
  url: postgresql+psycopg2://REPLACE_ME:REPLACE_ME@pgbouncer:6432/dydx_platform?sslmode=disable
---
apiVersion: v1
kind: Secret
metadata:
  name: bot-database
type: Opaque
stringData:
  url: postgresql+psycopg2://REPLACE_ME:REPLACE_ME@pgbouncer:6432/dydx_bot?sslmode=disable
---
apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
type: Opaque
stringData:
  bot-api-token: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: bot-secrets
type: Opaque
stringData:
  bot-api-token: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: minio-credentials
type: Opaque
stringData:
  accessKey: REPLACE_ME
  secretKey: REPLACE_ME
