# Copy this file to secrets.local-secret.yaml for local bootstrap.
# The copied file is ignored by Git via .gitignore.
# Replace every placeholder before applying to a cluster.

apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
type: Opaque
stringData:
  username: REPLACE_ME
  password: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: backend-database
type: Opaque
stringData:
  url: postgres://REPLACE_ME:REPLACE_ME@pgbouncer:6432/dydx_platform?sslmode=disable
---
apiVersion: v1
kind: Secret
metadata:
  name: bot-database
type: Opaque
stringData:
  url: postgresql+psycopg2://REPLACE_ME:REPLACE_ME@pgbouncer:6432/dydx_bot?sslmode=disable
---
apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
type: Opaque
stringData:
  bot-api-token: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: bot-secrets
type: Opaque
stringData:
  bot-api-token: REPLACE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: minio-credentials
type: Opaque
stringData:
  accessKey: REPLACE_ME
  secretKey: REPLACE_ME
---
# Consumed by the bot-worker Deployment as:
#   env:
#     - name: BACKTEST_MINIO_ACCESS_KEY
#       valueFrom: { secretKeyRef: { name: backtest-minio, key: access-key } }
#     - name: BACKTEST_MINIO_SECRET_KEY
#       valueFrom: { secretKeyRef: { name: backtest-minio, key: secret-key } }
apiVersion: v1
kind: Secret
metadata:
  name: backtest-minio
type: Opaque
stringData:
  access-key: REPLACE_ME
  secret-key: REPLACE_ME
---
# Consumed by the bot-worker Deployment as:
#   env:
#     - name: BACKTEST_CLICKHOUSE_PASSWORD
#       valueFrom: { secretKeyRef: { name: backtest-clickhouse, key: password } }
apiVersion: v1
kind: Secret
metadata:
  name: backtest-clickhouse
type: Opaque
stringData:
  password: REPLACE_ME
