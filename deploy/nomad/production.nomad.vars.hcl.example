# Copy to production.nomad.vars.hcl and fill real values.
# Keep the real file out of git.

nomad_node_name = "nomad-cp-01"

environment    = "production"
app_config_env = "production"
log_level      = "INFO"

app_domain = "executionlab.io"
api_domain = "api.executionlab.io"

# Use prebuilt, pushed images (for example GHCR)
frontend_image = "ghcr.io/cploutarchou/dydx-trading-bot-frontend:latest"
backend_image  = "ghcr.io/cploutarchou/dydx-trading-bot-backend:latest"
bot_image      = "ghcr.io/cploutarchou/dydx-trading-bot-bot:latest"

app_db_name = "app"
app_db_user = "app"

# Secrets
app_db_password = "REPLACE_ME"
secret_key      = "REPLACE_ME"
jwt_secret_key  = "REPLACE_ME"
encryption_key  = "REPLACE_ME"
bot_api_token   = "REPLACE_ME"
