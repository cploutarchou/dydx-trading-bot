# VITE_* build args are public frontend config baked into the JS bundle — not secrets.
# checkov:skip=CKV_DOCKER_4 checkov:skip=CKV_DOCKER_8
# check=skip=SecretsUsedInArgOrEnv

# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /repo

# Stub files so vite.config.ts find_repo_root() can locate the repo root.
# vite.config uses __dirname (frontend/) and walks up to find .github + AGENTS.md
# + run.json or config/profiles. All real VITE_* vars come from build args below.
RUN mkdir -p .github && touch AGENTS.md && echo '{}' > run.json

# Install frontend dependencies
COPY frontend/.npmrc frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci

# Copy frontend source
COPY frontend/ ./frontend/

# VITE_* values are baked into the JS bundle at build time.
# Set VITE_APP_PORTAL_TYPE to client, backoffice, or ib for separate portal images.
ARG VITE_API_URL=https://api.executionlab.io
ARG VITE_API_BASE_URL=$VITE_API_URL
ARG VITE_AUTH_BASE_URL=$VITE_API_BASE_URL
ARG VITE_APP_PORTAL_TYPE=client
ARG VITE_CLIENT_HOST=app.executionlab.io
ARG VITE_CRM_HOST=crm.executionlab.io
ARG VITE_IB_PORTAL_HOST=ib.executionlab.io
ARG VITE_FORCE_MOCK_DATA=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_AUTH_BASE_URL=$VITE_AUTH_BASE_URL
ENV VITE_APP_PORTAL_TYPE=$VITE_APP_PORTAL_TYPE
ENV VITE_CLIENT_HOST=$VITE_CLIENT_HOST
ENV VITE_CRM_HOST=$VITE_CRM_HOST
ENV VITE_IB_PORTAL_HOST=$VITE_IB_PORTAL_HOST
ENV VITE_FORCE_MOCK_DATA=$VITE_FORCE_MOCK_DATA

RUN cd frontend && npm run build

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /repo/frontend/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
