# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /repo

# Stub files so vite.config.ts find_repo_root() can locate the repo root.
# vite.config uses __dirname (frontend/) and walks up to find .github + AGENTS.md
# + run.json or config/profiles. All real VITE_* vars come from build args below.
RUN mkdir -p .github && touch AGENTS.md && echo '{}' > run.json

# Install frontend dependencies
COPY frontend/.npmrc frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci

# Copy frontend source
COPY frontend/ ./frontend/

# VITE_API_URL is baked into the JS bundle at build time.
# Override with --build-arg VITE_API_URL=... for custom deployments.
ARG VITE_API_URL=https://api.cydevcloud.com
ARG VITE_FORCE_MOCK_DATA=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_FORCE_MOCK_DATA=$VITE_FORCE_MOCK_DATA

RUN cd frontend && npm run build

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /repo/frontend/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
