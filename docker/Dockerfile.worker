FROM python:3.14-slim

WORKDIR /app

# System deps for scipy and numpy.
RUN apt-get update && apt-get install -y --no-install-recommends \
	gcc \
	&& rm -rf /var/lib/apt/lists/*

# Install Python dependencies first (layer caching)
COPY bot/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Create an unprivileged runtime user for Celery and bot processes
RUN addgroup --system app \
	&& adduser --system --ingroup app app \
	&& mkdir -p /app/bot_states \
	&& chown app:app /app /app/bot_states

# Copy bot source
COPY --chown=app:app bot/ .

# Stub so env_loader.find_repo_root() succeeds.
# Runtime configuration is injected through environment variables.
RUN echo '{}' > /app/run.json

ENV APP_ENV=prod
ENV ENVIRONMENT=prod

USER app

CMD ["python", "worker_entrypoint.py"]
