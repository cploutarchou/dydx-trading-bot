# Arbitrage improvement feature flags
ARBITRAGE_IMPROVEMENTS_ENABLED=false
PAIR_PRIORITY_ENGINE_ENABLED=false
POLYMARKET_SIGNALS_ENABLED=false
DEFILLAMA_SIGNALS_ENABLED=false
NEWS_SIGNALS_ENABLED=false
AUTO_EXECUTION_CHANGES_ENABLED=false

# Optional pair-priority tuning
# 0 means keep all ranked pairs; positive values scan only the top N when
# PAIR_PRIORITY_ENGINE_ENABLED=true.
PAIR_PRIORITY_MAX_PAIRS=0
PAIR_PRIORITY_STALE_SECONDS=86400

# Existing dYdX API efficiency controls
DYDX_API_THROTTLE_MS=200
DYDX_RATE_LIMIT_RPS=5
DYDX_RATE_LIMIT_WINDOW=1.0
DYDX_CIRCUIT_FAIL_MAX=3
DYDX_CIRCUIT_RESET_TIMEOUT=30
MARKETS_CACHE_TTL_SECONDS=60
MARKETS_STALE_TTL_SECONDS=300
CANDLES_RECENT_CACHE_TTL_SECONDS=30
CANDLE_FETCH_CONCURRENCY=10

# Optional scheduler hook. Disabled by default; no market sync work runs unless
# explicitly enabled and implemented for the deployment.
MARKET_SYNC_ENABLED=false
