# Shared monorepo environment template
# Copy this file to .env in the repo root and keep all service configuration there.
# Frontend, backend, and bot all read the same root .env.

# ============================================================================
# Frontend (Vite)
# ============================================================================
VITE_API_URL=http://localhost:8888
VITE_FORCE_MOCK_DATA=false

# ============================================================================
# Shared app runtime
# ============================================================================
APP_ENV=development
ENVIRONMENT=development
IS_TESTNET=true
API_PORT=8888
PROXY_HTTP_PORT=8080
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Auth and secret management
# ============================================================================
# SECRET_KEY is kept for legacy compatibility. JWT_SECRET_KEY is preferred.
SECRET_KEY=change-me-dev-secret-key-min-32-characters
JWT_SECRET_KEY=change-me-dev-secret-key-min-32-characters
ENCRYPTION_KEY=change-me-encryption-key-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Backend <-> Bot service auth
# ============================================================================
BOT_API_URL=http://127.0.0.1:8889
BOT_API_USE_SERVICE_TOKEN=true
BOT_API_TOKEN=dev-local-service-token
BOT_API_TOKEN_PREVIOUS=
BOT_API_TOKENS=
API_BYPASS_AUTH=false

# ============================================================================
# Database
# ============================================================================
# Service-first local development can use sqlite3; full stack can use postgres.
DB_TYPE=sqlite3
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dydx_bot
DB_USER=dydx_bot
DB_PASSWORD=dydx_bot
DB_TIMEOUT=5
DB_ENABLED=true
DB_POOL_SIZE=5
DB_MAX_CONNECTIONS=10
DB_MAX_OVERFLOW=10
SSL_MODE=false
DB_ECHO_SQL=false

# Docker/integration stack postgres aliases
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dydx_bot
POSTGRES_USER=dydx_bot
POSTGRES_PASSWORD=dydx_bot

# ============================================================================
# Redis
# ============================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=5
REDIS_CACHE_TTL=86400
REDIS_MAX_CONNECTIONS=10

# ============================================================================
# Bot API server
# ============================================================================
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8889
BOT_API_RELOAD=true
BOT_API_WORKERS=1
BOT_PYTHON_PATH=
BOT_MANAGER_MONITOR_INTERVAL_SECONDS=10
BOT_STARTUP_GRACE_SECONDS=0.2

# ============================================================================
# Bot runtime defaults
# ============================================================================
BOT_PLACE_TRADES=false
BOT_MANAGE_EXITS=false
BOT_ABORT_ALL_POSITIONS=false
BOT_FIND_COINTEGRATED_PAIRS=true
BOT_RESOLUTION_TIMEFRAME=1HOUR
BOT_STRATEGY=cointegration
BOT_STATS_WINDOW=21
BOT_MAX_HALF_LIFE=24
BOT_ZSCORE_THRESHOLD=1.5
BOT_USD_PER_TRADE=10.0
BOT_USD_MIN_COLLATERAL=100.0
BOT_CLOSE_AT_ZSCORE_CROSS=true

# ============================================================================
# Backtesting
# ============================================================================
BACKTEST_CANDLE_RESOLUTION=1HOUR
BACKTEST_MAX_HISTORY_DAYS=90
BACKTEST_STARTING_BALANCE=1000.0
BACKTEST_TRANSACTION_FEE=0.0005
BACKTEST_SLIPPAGE=0.001
BACKTEST_BENCHMARK_SYMBOL=BTC-USD
BACKTEST_RISK_FREE_RATE=0.02

# ============================================================================
# dYdX credentials
# ============================================================================
DYDX_TESTNET_ADDRESS=
DYDX_TESTNET_MNEMONIC=
DYDX_MAINNET_ADDRESS=
DYDX_MAINNET_MNEMONIC=

# ============================================================================
# Observability
# ============================================================================
LOG_LEVEL=INFO
LOKI_ENABLED=false
LOKI_URL=
LOKI_PUSH_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=
LOKI_LABELS={}

# ============================================================================
# Notifications
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_RETRIES=3
TELEGRAM_DEDUPE_SECONDS=0

# ============================================================================
# Market and email integrations
# ============================================================================
CODEX_IO_API_KEY=
CODEX_IO_BASE_URL=https://graph.codex.io/graphql
COINDESK_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/
MAILGUN_API_BASE_URL=
MAILGUN_API_BASE_URL_EU=
