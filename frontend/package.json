{
	"name": "dydx-backtest-ui",
	"version": "1.0.0",
	"type": "module",
	"description": "Interactive UI for dYdX Backtest System",
	"private": true,
	"dependencies": {
		"@headlessui/react": "2.2.10",
		"@tailwindcss/forms": "0.5.11",
		"@tanstack/react-query": "5.100.9",
		"@tanstack/react-query-devtools": "5.100.9",
		"axios": "1.16.0",
		"date-fns": "^4.1.0",
		"lightweight-charts": "^5.2.0",
		"lucide-react": "^1.11.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.74.0",
		"react-router-dom": "^7.9.4",
		"recharts": "^3.3.0",
		"tailwindcss": "^4.1.14",
		"vite": "8.0.12",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.39.4",
		"@tailwindcss/postcss": "^4.1.14",
		"@types/node": "^25.5.2",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@typescript-eslint/eslint-plugin": "^8.59.1",
		"@typescript-eslint/parser": "^8.59.1",
		"@vitejs/plugin-react": "6.0.1",
		"autoprefixer": "^10.4.16",
		"eslint": "^9.39.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"postcss": "^8.5.14",
		"typescript": "6.0.3",
		"vitest": "4.1.5"
	},
	"scripts": {
		"dev": "vite",
		"dev:client": "VITE_APP_PORTAL_TYPE=client vite",
		"dev:backoffice": "VITE_APP_PORTAL_TYPE=backoffice vite --port 5174",
		"dev:ib": "VITE_APP_PORTAL_TYPE=ib vite --port 5175",
		"build": "vite build",
		"build:client": "VITE_APP_PORTAL_TYPE=client vite build --outDir dist/client-portal",
		"build:backoffice": "VITE_APP_PORTAL_TYPE=backoffice vite build --outDir dist/backoffice",
		"build:ib": "VITE_APP_PORTAL_TYPE=ib vite build --outDir dist/ib-portal",
		"preview": "vite preview",
		"lint": "eslint src --ext .ts,.tsx",
		"typecheck": "tsc --noEmit",
		"test:contracts": "vitest run src/api/contractGuards.test.ts",
		"qa:screenshots:plan": "node ./scripts/capture-responsive-screenshots.mjs --dry-run",
		"qa:screenshots:capture": "node ./scripts/capture-responsive-screenshots.mjs",
		"qa:screenshots:sync": "node ./scripts/update-responsive-screenshot-checklist.mjs"
	},
	"browserslist": [
		"Firefox >= 110",
		"Chrome >= 111",
		"Safari >= 16.4",
		"Edge >= 111"
	]
}