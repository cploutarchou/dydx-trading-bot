{
  "name": "dydx-backtest-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "ExecutionLab technical execution workspace",
  "private": true,
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@tailwindcss/forms": "0.5.11",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "animejs": "^4.4.1",
    "axios": "1.17.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.40.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.3.0",
    "tailwindcss": "^4.1.14",
    "vite": "8.0.16",
    "zustand": "^5.0.14",
    "@react-buddy/ide-toolbox": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.13.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.15.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.15",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation vite",
    "dev:client": "NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=client vite",
    "dev:backoffice": "NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=backoffice vite --port 5174",
    "dev:ib": "NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=ib vite --port 5175",
    "build": "NODE_OPTIONS=--no-deprecation vite build",
    "build:client": "NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=client vite build --outDir dist/client-portal",
    "build:backoffice": "NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=backoffice vite build --outDir dist/backoffice",
    "build:ib": "NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=ib vite build --outDir dist/ib-portal",
    "preview": "NODE_OPTIONS=--no-deprecation vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:contracts": "NODE_OPTIONS=--no-deprecation vitest run src/api/contractGuards.test.ts",
    "qa:screenshots:plan": "node ./scripts/capture-responsive-screenshots.mjs --dry-run",
    "qa:screenshots:capture": "node ./scripts/capture-responsive-screenshots.mjs",
    "qa:screenshots:sync": "node ./scripts/update-responsive-screenshot-checklist.mjs",
    "qa:crypto-background": "node ./scripts/verify-crypto-background-browser.mjs"
  },
  "browserslist": [
    "Firefox >= 110",
    "Chrome >= 111",
    "Safari >= 16.4",
    "Edge >= 111"
  ]
}
