{
  "name": "dydx-backtest-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "ExecutionLab technical execution workspace",
  "private": true,
  "dependencies": {
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.103.1",
    "animejs": "^4.4.1",
    "axios": "1.17.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.17.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "eslint": "^9.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.15",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vitest": "4.1.8"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite",
    "dev:client": "cross-env NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=client vite",
    "dev:backoffice": "cross-env NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=backoffice vite --port 5174",
    "dev:ib": "cross-env NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=ib vite --port 5175",
    "build": "cross-env NODE_OPTIONS=--no-deprecation vite build",
    "build:client": "cross-env NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=client vite build --outDir dist/client-portal",
    "build:backoffice": "cross-env NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=backoffice vite build --outDir dist/backoffice",
    "build:ib": "cross-env NODE_OPTIONS=--no-deprecation VITE_APP_PORTAL_TYPE=ib vite build --outDir dist/ib-portal",
    "preview": "cross-env NODE_OPTIONS=--no-deprecation vite preview",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-deprecation vitest",
    "test:contracts": "cross-env NODE_OPTIONS=--no-deprecation vitest run src/api/contractGuards.test.ts",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test",
    "qa:screenshots:plan": "node ./scripts/capture-responsive-screenshots.mjs --dry-run",
    "qa:screenshots:capture": "node ./scripts/capture-responsive-screenshots.mjs",
    "qa:screenshots:sync": "node ./scripts/update-responsive-screenshot-checklist.mjs",
    "qa:crypto-background": "node ./scripts/verify-crypto-background-browser.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "browserslist": [
    "Firefox >= 110",
    "Chrome >= 111",
    "Safari >= 16.4",
    "Edge >= 111"
  ]
}
